# ============================================================
# CyberShield AI local development environment
# Copy this file to .env and replace placeholder values.
# Never commit the real .env file.
# ============================================================

APP_NAME=CyberShield AI
APP_ENV=development
APP_DEBUG=true

BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

FRONTEND_PORT=5173

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=cybershield
POSTGRES_USER=cybershield
POSTGRES_PASSWORD=replace-with-a-local-password

DATABASE_URL=postgresql+psycopg://cybershield:replace-with-a-local-password@localhost:5432/cybershield

SECRET_KEY=replace-with-a-long-random-development-secret
ACCESS_TOKEN_EXPIRE_MINUTES=30

AWS_REGION=eu-north-1
AWS_S3_BUCKET=
