# ============================================================
# CyberShield AI Platform
# Git ignore configuration
# ============================================================

# Environment variables and secrets
.env
.env.*
!.env.example
secrets/
credentials/
certificates/

# AWS credentials and keys
.aws/
*.pem
*.key
*.p12
*.pfx

# Terraform
.terraform/
*.tfstate
*.tfstate.*
*.tfplan
*.tfvars
*.tfvars.json
crash.log
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
coverage.xml
htmlcov/
venv/
.venv/
env/

# Node.js
node_modules/
dist/
build/
coverage/
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# React and Vite
frontend/dist/
frontend/.vite/

# Logs
*.log
logs/

# Database files and backups
*.db
*.sqlite
*.sqlite3
*.sql
*.dump
backups/

# Test artifacts
test-results/
playwright-report/

# IDE settings
.idea/
*.swp
*.swo

# Keep shared VS Code project settings
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
!.vscode/launch.json
!.vscode/tasks.json

# Operating system files
.DS_Store
Thumbs.db
Desktop.ini

# Temporary files
tmp/
temp/
.cache/
